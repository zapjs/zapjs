{
  "name": "zapjs",
  "version": "0.3.0",
  "private": true,
  "description": "Integrated React framework with managed deployment and optional Rust functions",
  "workspaces": [
    "packages/client"
  ],
  "scripts": {
    "build": "bun run --cwd packages/client build",
    "test": "bun test packages/client/src && cargo test --workspace",
    "verify": "node scripts/verify.mjs"
  },
  "keywords": [
    "react",
    "rust",
    "framework",
    "typescript",
    "fullstack",
    "rsc",
    "ssr",
    "managed-deployment"
  ],
  "author": "saint0x",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saint0x/zapjs.git"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
