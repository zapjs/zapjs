{
  "name": "@zap-js/client",
  "version": "0.3.0",
  "description": "ZapJS integrated React framework with managed deployment and native Rust functions",
  "homepage": "https://github.com/saint0x/zapjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/saint0x/zapjs.git"
  },
  "bugs": {
    "url": "https://github.com/saint0x/zapjs/issues"
  },
  "type": "module",
  "main": "./dist/framework/client.js",
  "types": "./dist/framework/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/framework/client.d.ts",
      "default": "./dist/framework/client.js"
    },
    "./client": {
      "types": "./dist/framework/client.d.ts",
      "default": "./dist/framework/client.js"
    },
    "./server": {
      "types": "./dist/framework/server.d.ts",
      "default": "./dist/framework/server.js"
    },
    "./cache": {
      "types": "./dist/framework/cache.d.ts",
      "default": "./dist/framework/cache.js"
    },
    "./compiler": {
      "types": "./dist/compiler/config.d.ts",
      "default": "./dist/compiler/config.js"
    },
    "./native/rust/Cargo.toml": "./dist/native/rust/Cargo.toml"
  },
  "bin": {
    "zap": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1",
    "react-server-dom-webpack": "19.3.0",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitejs/plugin-react": "6.1.1",
    "rsc-html-stream": "0.0.8",
    "@vercel/nft": "1.11.0",
    "@napi-rs/cli": "3.10.5",
    "mime-types": "3.0.2",
    "parse5-sax-parser": "8.0.0"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/mime-types": "^3.0.1",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0"
  },
  "keywords": [
    "zapjs",
    "react",
    "rust",
    "framework",
    "rsc",
    "ssr",
    "typescript"
  ],
  "author": "saint0x",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
